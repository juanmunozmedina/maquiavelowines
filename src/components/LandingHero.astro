---
import twoXl from '~/assets/maquiavelo-banner-2xl.webp';
import lg from '~/assets/maquiavelo-banner-lg.webp';
import md from '~/assets/maquiavelo-banner-md.webp';
import sm from '~/assets/maquiavelo-banner-sm.webp';
import xl from '~/assets/maquiavelo-banner-xl.webp';
import { button } from '~/styles.ts';
---

<header
	class="breakout focus-ring-light dark:text-base-theme-100 relative h-[384px] max-h-dvh content-center-safe justify-items-center gap-y-4 bg-black py-8 text-white md:h-[512px] md:gap-y-8 md:bg-bottom"
>
	<picture>
		<source srcset={sm.src} media="(max-width: 640px)" />
		<source srcset={md.src} media="(max-width: 768px)" />
		<source srcset={lg.src} media="(max-width: 1024px)" />
		<source srcset={xl.src} media="(max-width: 1280px)" />
		<source srcset={twoXl.src} media="(min-width: 1281px)" />
		<img
			fetchpriority="high"
			src={twoXl.src}
			alt="Bodegas Maquiavelo"
			class="breakout absolute inset-0 size-full object-cover object-right-bottom"
		/>
	</picture>
	<div
		class="content relative text-3xl font-extrabold drop-shadow-md md:text-5xl md:leading-[50px]"
	>
		<h1>Que hable el vino</h1>
	</div>
	<div class="relative">
		<a
			class="bg-theme-base-100 hover:bg-theme-base-200 text-theme-base-900 dark:bg-theme-base-900 dark:hover:bg-theme-base-600 dark:text-white h-9 px-4 text-sm uppercase transition flex items-center justify-center gap-1.5 font-bold md:h-12 md:text-lg"
			href="#products">Compra ahora</a
		>
	</div>
</header>
